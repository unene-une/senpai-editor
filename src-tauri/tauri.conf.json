{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "senpai-editor",
  "version": "1.1.0",
  "identifier": "com.senpai-editor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Senpai Editor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Senpai Editor Team",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "installerHooks": "nsis/custom_inc.nsh",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": []
  }
}